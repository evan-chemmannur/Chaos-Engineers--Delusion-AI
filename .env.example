# LoveAI Environment Configuration

# Optional external LLM API Key (Google Gemini, OpenAI, or compatible provider)
# If left empty, LoveAI uses its built-in intelligent fallback engine for 100% offline demos.
LLM_API_KEY=
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash

# Optional application preferences
SAVE_AI_HISTORY=true
THEME_MODE=dark
